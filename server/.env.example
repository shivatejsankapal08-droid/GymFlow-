# ==============================================================================
# GYMFLOW AI - Environment Configuration
# ==============================================================================

PORT=5000
NODE_ENV=development

# FRONTEND CLIENT URL (for CORS)
CLIENT_URL=http://localhost:5173

# SUPABASE CONFIGURATION
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OPENAI API (for AI Assistant, Workout & Business Insights)
OPENAI_API_KEY=sk-proj-yourOpenAIKeyHere
OPENAI_MODEL=gpt-4o-mini

# RAZORPAY PAYMENT GATEWAY
# Test Keys: rzp_test_... / Secret
RAZORPAY_KEY_ID=rzp_test_YourTestKeyId
RAZORPAY_KEY_SECRET=YourTestKeySecret
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecret

# N8N & AUTOMATION
GYMFLOW_AUTOMATION_SECRET=gymflow_secret_key_2026
N8N_WEBHOOK_URL=http://localhost:5678/webhook/gymflow-alerts

# WHATSAPP CLOUD API (Meta Graph)
WHATSAPP_PHONE_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-meta-whatsapp-system-user-access-token
