{
  "name": "GymFlow AI - Attendance Check-in & Check-out Alerts",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "gymflow-attendance-event",
        "options": {}
      },
      "id": "node-attendance-webhook",
      "name": "Webhook: attendance.event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "gymflow-attendance-event"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-attendance-type",
              "leftValue": "={{$json.body.type}}",
              "rightValue": "check_in",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-check-event-type",
      "name": "Check-in vs Check-out",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/{{$env.WHATSAPP_PHONE_ID}}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.WHATSAPP_ACCESS_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"recipient_type\": \"individual\",\n  \"to\": \"{{$json.body.memberPhone}}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"🏋️ Welcome to \" + $json.body.gymName + \", \" + $json.body.memberName + \"! Checked in at \" + $json.body.time + \". Have an energizing workout! 💪\"\n  }\n}"
      },
      "id": "node-send-checkin-whatsapp",
      "name": "WhatsApp: Send Check-in Welcome",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [740, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/{{$env.WHATSAPP_PHONE_ID}}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.WHATSAPP_ACCESS_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"recipient_type\": \"individual\",\n  \"to\": \"{{$json.body.memberPhone}}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"✅ Checked out from \" + $json.body.gymName + \" at \" + $json.body.time + \". Session duration: \" + ($json.body.durationMinutes || 45) + \" mins. Keep up the consistency! 🔥\"\n  }\n}"
      },
      "id": "node-send-checkout-whatsapp",
      "name": "WhatsApp: Send Check-out Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [740, 400]
    }
  ],
  "connections": {
    "Webhook: attendance.event": {
      "main": [
        [
          {
            "node": "Check-in vs Check-out",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check-in vs Check-out": {
      "main": [
        [
          {
            "node": "WhatsApp: Send Check-in Welcome",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "WhatsApp: Send Check-out Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
