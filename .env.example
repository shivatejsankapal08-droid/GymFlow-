# ==============================================================================
# GYMFLOW AI: MASTER PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.
# Copy this file to .env and provide production credentials.

# --- SERVER ENVIRONMENT ---
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://gymflow.vercel.app
CLIENT_URL=https://gymflow.vercel.app

# --- SUPABASE DATABASE & AUTHENTICATION ---
# Find in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- RAZORPAY PAYMENT GATEWAY ---
# Find in Razorpay Dashboard -> Settings -> API Keys & Webhooks
RAZORPAY_KEY_ID=rzp_live_YourLiveKeyId
RAZORPAY_KEY_SECRET=YourLiveKeySecret
RAZORPAY_WEBHOOK_SECRET=YourLiveWebhookSecret

# --- OPENAI ASSISTANT ENGINE ---
# Find in OpenAI Platform -> API Keys
OPENAI_API_KEY=sk-proj-YourProductionKeyHere
OPENAI_MODEL=gpt-4o-mini

# --- META WHATSAPP CLOUD API ---
# Find in Meta for Developers -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=109823487192837
WHATSAPP_PHONE_ID=109823487192837
WHATSAPP_ACCESS_TOKEN=EAABwz...

# --- N8N WORKFLOW AUTOMATION ---
N8N_WEBHOOK_URL=https://n8n.your-domain.com/webhook/gymflow-alerts
GYMFLOW_AUTOMATION_SECRET=your_high_entropy_secret_key_2026

# --- FRONTEND CLIENT VARIABLES (VITE_) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_API_BASE_URL=https://gymflow-api.onrender.com
